From 4380c2d8ad72e4f7ffd3dae3ad1de78159c2f2ba Mon Sep 17 00:00:00 2001
From: Gary Lin <glin@suse.com>
Date: Tue, 30 Jan 2024 14:41:10 +0800
Subject: [PATCH] util/bash-completion: Load scripts on demand

Fully merged in grub 2.14 upstream. Retained as a minimal packaging marker
(Patch1000) so the historical reference remains; only a documentation
comment is applied.

--- a/util/bash-completion.d/Makefile.am
+++ b/util/bash-completion.d/Makefile.am
@@ -115,3 +115,4 @@
 
 $(grub_sparc64_setup_script): $(grub_sparc64_setup_source) $(top_builddir)/config.status
 	$(top_builddir)/config.status --file=$@:$<
+# On-demand completion scripts (see grub-*.bash.in); feature merged upstream in 2.14.
