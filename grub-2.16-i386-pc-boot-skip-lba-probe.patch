From: Bernhard Rosenkränzer <bero@lindev.ch>
Subject: i386-pc/boot.S: do not probe INT 13h extensions after "GRUB "

boot.img prints "GRUB " and then calls INT 13h AH=41 (check LBA)
followed by AH=42 (LBA read of the first core.img sector). On some
firmwares those calls never return, so the machine freezes on that
banner and diskboot never prints "loading".

The first core.img sector lives in the MBR gap or BIOS boot
partition, which is always CHS-reachable. Skip the LBA probe and
read that sector with CHS. diskboot then inherits the CHS flag.

---
 grub-core/boot/i386/pc/boot.S | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/grub-core/boot/i386/pc/boot.S b/grub-core/boot/i386/pc/boot.S
--- a/grub-core/boot/i386/pc/boot.S
+++ b/grub-core/boot/i386/pc/boot.S
@@ -255,6 +255,13 @@ real_start:
 	/* set %si to the disk address packet */
 	movw	$disk_address_packet, %si
 
+	/*
+	 * Some BIOSes hang in INT 13h AH=41/42 after this point.
+	 * The first core.img sector is in the embedding area (CHS).
+	 * Skip the LBA probe; diskboot keeps the CHS flag we set.
+	 */
+	jmp	LOCAL(chs_mode)
+
 	/* check if LBA is supported */
 	movb	$0x41, %ah
 	movw	$0x55aa, %bx
	int	$0x13
